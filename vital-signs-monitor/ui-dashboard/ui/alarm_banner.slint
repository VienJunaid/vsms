// Color-coded banner reflecting the current AlarmLevel from control-core.
// level: 0 = Normal (green), 1 = Warning (amber), 2 = Critical (red, flashing).
export component AlarmBanner inherits Rectangle {
    in property <int> level: 0;
    property <bool> flash-on: true;

    border-radius: 8px;
    background: level == 2 ? #7a1f1f : (level == 1 ? #7a5c1f : #1f3a26);
    border-color: level == 2 ? #ff4d4d : (level == 1 ? #ffb84d : #39ff6a);
    border-width: 2px;
    // Critical alarms flash to draw attention, matching real bedside
    // monitor behavior for the highest-priority alarm state.
    opacity: level == 2 ? (flash-on ? 1.0 : 0.55) : 1.0;

    animate opacity { duration: 500ms; easing: ease-in-out; }

    Timer {
        interval: 500ms;
        running: root.level == 2;
        triggered => { root.flash-on = !root.flash-on; }
    }

    Text {
        text: level == 2 ? "CRITICAL ALARM" : (level == 1 ? "WARNING" : "NORMAL — ALL VITALS WITHIN RANGE");
        color: #ffffff;
        font-size: 20px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}
