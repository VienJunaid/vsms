// Scrolling ECG trace, classic green-on-black "EKG strip" style.
// `ecg-path` is SVG path data built in Rust from a ring buffer of the last
// 600 samples (see src/slint_main.rs); the Path element's viewbox maps that
// fixed 600x300 coordinate space onto whatever pixel size this widget ends
// up with.
export component Waveform inherits Rectangle {
    in property <string> ecg-path: "";

    background: #000000;
    border-color: #1f2630;
    border-width: 1px;
    border-radius: 6px;

    for col in 25: Rectangle {
        x: col / 25.0 * parent.width;
        width: 1px;
        height: 100%;
        background: #163a1f;
    }
    for row in 12: Rectangle {
        y: row / 12.0 * parent.height;
        width: 100%;
        height: 1px;
        background: #163a1f;
    }

    Path {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 600;
        viewbox-height: 300;
        stroke: #39ff6a;
        stroke-width: 2px;
        commands: root.ecg-path;
    }

    Text {
        x: 12px;
        y: 12px;
        text: "ECG";
        color: #39ff6a;
        font-size: 14px;
        font-weight: 700;
    }
}
